# ---------------------------------------------------------------------------
# SSW funnel — environment. Copy to apps/web/.env.local for local dev.
# Anything left empty runs in mock / log mode, so the whole funnel works locally.
# ---------------------------------------------------------------------------

# Public URL (used in the resume and booking links sent to Slixta)
SITE_URL=http://localhost:3000
# Required in production: signs booking / resume links
LINK_SIGNING_SECRET=

# Ops DB. Empty = PGlite (in-process Postgres in ./.data/pglite). Production: postgres://...
DATABASE_URL=

# Jobs and timers: postgres (demo/local tick) | sqs (AWS: SQS + EventBridge Scheduler)
QUEUE_DRIVER=postgres
# AWS only
AWS_REGION=ap-south-1
SQS_QUEUE_URL=
SQS_QUEUE_ARN=
SCHEDULER_ROLE_ARN=
SCHEDULER_GROUP=default
# Protects /api/cron/tick (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Slixta CRM (docs/02): lead, CHECKOUT ABANDONED, APPOINTMENT BOOKED. Live once all four are set,
# otherwise mock (logs every call). One data source for every centre; the page link routes the lead.
# Slixta issues a separate key for each API.
SLIXTA_SUBMIT_API_KEY=
SLIXTA_INTERACTIONS_API_KEY=
SLIXTA_ORG_ID=
SLIXTA_DATA_SOURCE_ID=
# Optional: Slixta staff email the interactions are attributed to
SLIXTA_AGENT_EMAIL=
# Service name(s) for APPOINTMENT BOOKED, comma-separated, as named in Slixta
SLIXTA_APPOINTMENT_SERVICE=Consultation
# Defaults: https://hook.slixta.com (submits) and https://cdp.slixta.com (interactions)
SLIXTA_SUBMIT_URL=
SLIXTA_INTERACTIONS_URL=
# Per-centre owner ID kept on our own contact record (override packages/content)
SLIXTA_OWNER_ID_AHM=

# Our calendar app (docs/03). Empty URL = mock calendar (slot grid from the mock-up)
CALENDAR_API_URL=
CALENDAR_API_KEY=
CALENDAR_WEBHOOK_SECRET=

# I AM Partner Booking API (docs/06). Setting the URL and a key switches the calendar to I AM
# (or force it with CALENDAR_MODE=iam | http | mock). Server-side only: never expose these keys.
IAM_API_BASE_URL=
# One key per centre, used by every page of that centre: IAM_API_KEY_<CENTRE CODE>.
# No shared fallback: a centre without its own key can't book. Rotation: "new_key,old_key".
IAM_API_KEY_AHM=
# Optional. The centre code is read from GET /centres/ when unset; doctor IDs limit the list.
IAM_CENTRE_AHM=
IAM_EXPERT_IDS_AHM=
IAM_HTTP_TIMEOUT_MS=15000
# Close our checkout this long before I AM's hold expires
IAM_HOLD_CHECKOUT_BUFFER_SECONDS=60
# Browse caches (I AM allows 120 requests/min per key). Keep slots short.
IAM_CACHE_EXPERTS_SECONDS=300
IAM_CACHE_DATES_SECONDS=60
IAM_CACHE_SLOTS_SECONDS=20

# Razorpay. Empty keys = test mode with "Payment succeeds / fails" buttons
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# 1 / 0 to force test payments on or off (default: on outside production)
ALLOW_MOCK_PAYMENTS=

# Tracking
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Search engines: pages are noindex unless this is 1
ALLOW_INDEXING=
